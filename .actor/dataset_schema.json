{
    "actorSpecification": 1,
    "fields": {
        "type": "object",
        "properties": {
            "title": {
                "type": "string",
                "title": "Job Title",
                "description": "Job title",
                "example": "Junior Software Engineer"
            },
            "company": {
                "type": "string",
                "title": "Company",
                "description": "Hiring company name",
                "example": "TechCorp Ltd"
            },
            "location": {
                "type": "string",
                "title": "Location",
                "description": "Job location",
                "example": "London"
            },
            "salary_raw": {
                "type": "string",
                "title": "Salary",
                "description": "Original salary text from the listing",
                "example": "£30,000 - £40,000 per annum"
            },
            "salary_min": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Salary Min",
                "description": "Parsed minimum salary",
                "example": 30000
            },
            "salary_max": {
                "type": [
                    "number",
                    "null"
                ],
                "title": "Salary Max",
                "description": "Parsed maximum salary",
                "example": 40000
            },
            "salary_currency": {
                "type": "string",
                "title": "Salary Currency",
                "description": "ISO currency code, based on the job's source country — GBP, USD, EUR, or AUD",
                "example": "GBP"
            },
            "salary_period": {
                "type": "string",
                "title": "Salary Period",
                "description": "Salary period — annum, day, or hour",
                "example": "annum"
            },
            "employment_type": {
                "type": "string",
                "title": "Employment Type",
                "description": "Permanent, Contract, Temporary, or Part-time",
                "example": "Permanent"
            },
            "work_mode": {
                "type": "string",
                "title": "Work Mode",
                "description": "Remote, Hybrid or On-site where the listing states it (empty when not stated)",
                "example": "Hybrid"
            },
            "snippet": {
                "type": "string",
                "title": "Snippet",
                "description": "Short description from search results",
                "example": "We are looking for a passionate junior developer to join our growing team..."
            },
            "date_posted": {
                "type": "string",
                "title": "Date Posted",
                "description": "When the job was listed, normalised to an ISO date (YYYY-MM-DD) wherever the board gives a readable date; see posted_at for the full timestamp",
                "example": "2026-03-05"
            },
            "valid_through": {
                "type": "string",
                "title": "Valid Through",
                "description": "Application deadline (where available)",
                "example": "2026-04-05"
            },
            "url": {
                "type": "string",
                "title": "URL",
                "description": "Direct link to the job listing",
                "example": "https://www.reed.co.uk/jobs/junior-software-engineer/12345"
            },
            "job_id": {
                "type": "string",
                "title": "Job ID",
                "description": "Unique ID from the source board",
                "example": "12345"
            },
            "source": {
                "type": "string",
                "title": "Source",
                "description": "Which job board the listing came from",
                "example": "reed.co.uk"
            },
            "category": {
                "type": "string",
                "title": "Category",
                "description": "Job category — from the board where provided (e.g. Adzuna), otherwise inferred from the job title",
                "example": "IT Jobs"
            },
            "description": {
                "type": "string",
                "title": "Description",
                "description": "Full job description, formatted as Markdown (default), HTML or plain text per the Description Format input",
                "example": "**About the role**\n\nWe are looking for a passionate engineer..."
            },
            "sources": {
                "type": "array",
                "title": "Sources",
                "description": "Every board this exact job was found on, as {board, url}. One role seen on 3 boards becomes one record citing all 3.",
                "items": {
                    "type": "object",
                    "properties": {
                        "board": {
                            "type": "string"
                        },
                        "url": {
                            "type": "string"
                        }
                    }
                }
            },
            "source_count": {
                "type": "integer",
                "title": "Source Count",
                "description": "How many boards this merged job appeared on (1 = seen on a single board)",
                "example": 3
            },
            "ats": {
                "type": "string",
                "title": "ATS",
                "description": "Applicant Tracking System detected from the apply URL — greenhouse, lever, ashby, workday, workable, smartrecruiters, icims, taleo, and more (null when none detected)",
                "example": "greenhouse"
            },
            "direct_apply_url": {
                "type": "string",
                "title": "Direct Apply URL",
                "description": "The real company/ATS apply link when detected, otherwise the board listing URL — skips the aggregator where possible",
                "example": "https://boards.greenhouse.io/acme/jobs/12345"
            },
            "salary_annual_min": {
                "type": "integer",
                "title": "Annual Salary Min",
                "description": "Minimum salary standardised to an annual figure (daily/hourly/monthly rates annualised) for fair cross-board comparison",
                "example": 90000
            },
            "salary_annual_max": {
                "type": "integer",
                "title": "Annual Salary Max",
                "description": "Maximum salary standardised to an annual figure",
                "example": 110000
            },
            "salary_hourly": {
                "type": "number",
                "title": "Hourly Salary",
                "description": "Standardised hourly rate derived from the annual midpoint (2080 work hours/year)",
                "example": 48.08
            },
            "is_remote": {
                "type": "boolean",
                "title": "Remote",
                "description": "True when the role is remote (from location, title or a remote-first source board)",
                "example": true
            },
            "job_type": {
                "type": "string",
                "title": "Job Type",
                "description": "Normalized job type — fulltime, parttime, contract or internship (empty when it can't be determined)",
                "example": "fulltime"
            },
            "posted_at": {
                "type": "string",
                "title": "Posted At",
                "description": "Post date normalised to an ISO 8601 UTC timestamp (parsed from absolute or relative dates like '3 days ago')",
                "example": "2026-07-05T10:00:00+00:00"
            },
            "_type": {
                "type": "string",
                "title": "Record Type",
                "description": "Record type — absent for jobs, 'salary_benchmark' for benchmarks",
                "example": "salary_benchmark"
            },
            "benchmark_title": {
                "type": "string",
                "title": "Benchmark Title",
                "description": "Job title used for salary benchmark grouping"
            },
            "benchmark_location": {
                "type": "string",
                "title": "Benchmark Location",
                "description": "Location used for salary benchmark grouping"
            },
            "count": {
                "type": "integer",
                "title": "Sample Count",
                "description": "Number of salary data points in this benchmark"
            },
            "salary_mean": {
                "type": "integer",
                "title": "Mean Salary",
                "description": "Mean annual salary for this benchmark group"
            },
            "salary_median": {
                "type": "integer",
                "title": "Median Salary",
                "description": "Median annual salary for this benchmark group"
            },
            "salary_p25": {
                "type": "integer",
                "title": "25th Percentile",
                "description": "25th percentile annual salary"
            },
            "salary_p75": {
                "type": "integer",
                "title": "75th Percentile",
                "description": "75th percentile annual salary"
            }
        }
    },
    "views": {
        "jobs": {
            "title": "Job Listings",
            "description": "All scraped job listings across selected boards",
            "transformation": {
                "fields": [
                    "title",
                    "company",
                    "location",
                    "salary_raw",
                    "salary_annual_min",
                    "salary_annual_max",
                    "job_type",
                    "is_remote",
                    "work_mode",
                    "ats",
                    "direct_apply_url",
                    "source_count",
                    "posted_at",
                    "url",
                    "source",
                    "snippet"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "title": {
                        "label": "Job Title",
                        "format": "text"
                    },
                    "company": {
                        "label": "Company",
                        "format": "text"
                    },
                    "location": {
                        "label": "Location",
                        "format": "text"
                    },
                    "salary_raw": {
                        "label": "Salary",
                        "format": "text"
                    },
                    "salary_annual_min": {
                        "label": "Annual Min",
                        "format": "number"
                    },
                    "salary_annual_max": {
                        "label": "Annual Max",
                        "format": "number"
                    },
                    "job_type": {
                        "label": "Type",
                        "format": "text"
                    },
                    "is_remote": {
                        "label": "Remote",
                        "format": "boolean"
                    },
                    "work_mode": {
                        "label": "Work Mode",
                        "format": "text"
                    },
                    "ats": {
                        "label": "ATS",
                        "format": "text"
                    },
                    "direct_apply_url": {
                        "label": "Apply",
                        "format": "link"
                    },
                    "source_count": {
                        "label": "Sources",
                        "format": "number"
                    },
                    "posted_at": {
                        "label": "Posted",
                        "format": "text"
                    },
                    "url": {
                        "label": "Link",
                        "format": "link"
                    },
                    "source": {
                        "label": "Source",
                        "format": "text"
                    },
                    "snippet": {
                        "label": "Description",
                        "format": "text"
                    }
                }
            }
        }
    }
}