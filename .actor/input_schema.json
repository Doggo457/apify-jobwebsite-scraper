{
    "title": "International Jobs Board Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "keyword": {
            "title": "Job Role Preset",
            "type": "string",
            "description": "Pick a common role or choose 'Custom' and type your own below",
            "editor": "select",
            "default": "software engineer",
            "enum": [
                "software engineer",
                "data analyst",
                "data scientist",
                "web developer",
                "frontend developer",
                "backend developer",
                "fullstack developer",
                "devops engineer",
                "cloud engineer",
                "cybersecurity analyst",
                "product manager",
                "project manager",
                "UX designer",
                "business analyst",
                "marketing manager",
                "accountant",
                "nurse",
                "teacher",
                "sales executive",
                "customer service",
                "warehouse operative",
                "mechanical engineer",
                "electrical engineer",
                "civil engineer",
                "HR manager",
                "__custom__"
            ],
            "enumTitles": [
                "Software Engineer",
                "Data Analyst",
                "Data Scientist",
                "Web Developer",
                "Frontend Developer",
                "Backend Developer",
                "Fullstack Developer",
                "DevOps Engineer",
                "Cloud Engineer",
                "Cybersecurity Analyst",
                "Product Manager",
                "Project Manager",
                "UX Designer",
                "Business Analyst",
                "Marketing Manager",
                "Accountant",
                "Nurse",
                "Teacher",
                "Sales Executive",
                "Customer Service",
                "Warehouse Operative",
                "Mechanical Engineer",
                "Electrical Engineer",
                "Civil Engineer",
                "HR Manager",
                "Custom (type below)"
            ]
        },
        "custom_keyword": {
            "title": "Custom Keyword",
            "type": "string",
            "description": "Type your own search keyword here. Overrides the preset above when filled in.",
            "editor": "textfield",
            "nullable": true
        },
        "location": {
            "title": "Location Preset",
            "type": "string",
            "description": "Pick a common location or choose 'Custom' and type your own below",
            "editor": "select",
            "default": "London",
            "enum": [
                "London",
                "Manchester",
                "Birmingham",
                "Leeds",
                "Edinburgh",
                "Glasgow",
                "Bristol",
                "Liverpool",
                "Cardiff",
                "Belfast",
                "Cambridge",
                "Oxford",
                "Remote",
                "New York",
                "San Francisco",
                "Los Angeles",
                "Chicago",
                "Austin",
                "Seattle",
                "Washington DC",
                "Berlin",
                "Munich",
                "Paris",
                "Amsterdam",
                "Sydney",
                "Melbourne",
                "__custom__"
            ],
            "enumTitles": [
                "London",
                "Manchester",
                "Birmingham",
                "Leeds",
                "Edinburgh",
                "Glasgow",
                "Bristol",
                "Liverpool",
                "Cardiff",
                "Belfast",
                "Cambridge",
                "Oxford",
                "Remote",
                "New York",
                "San Francisco",
                "Los Angeles",
                "Chicago",
                "Austin",
                "Seattle",
                "Washington DC",
                "Berlin",
                "Munich",
                "Paris",
                "Amsterdam",
                "Sydney",
                "Melbourne",
                "Custom (type below)"
            ]
        },
        "custom_location": {
            "title": "Custom Location",
            "type": "string",
            "description": "Type your own location here. Overrides the preset above when filled in.",
            "editor": "textfield",
            "nullable": true
        },
        "country": {
            "title": "Country / Region",
            "type": "string",
            "description": "Target country for job search. Determines which boards are auto-selected, the proxy region and the default currency.",
            "editor": "select",
            "default": "uk",
            "enum": ["uk", "us", "de", "fr", "nl", "au", "remote"],
            "enumTitles": [
                "🇬🇧 United Kingdom (Reed, Totaljobs, CV-Library, CWJobs, Indeed UK, GOV.UK Find a Job, Adzuna)",
                "🇺🇸 United States (USAJobs, Indeed US, Adzuna, RemoteOK)",
                "🇩🇪 Germany (Indeed DE, Adzuna, Arbeitnow)",
                "🇫🇷 France (Indeed FR, Adzuna)",
                "🇳🇱 Netherlands (Indeed NL, Adzuna)",
                "🇦🇺 Australia (Indeed AU, Adzuna)",
                "🌍 Remote / Global (RemoteOK, Arbeitnow, Adzuna)"
            ]
        },
        "max_results": {
            "title": "Max Results",
            "type": "integer",
            "description": "Maximum total job listings to return (spread across all boards). Minimum 100. If some boards come up short the others are asked for more so you get the number you asked for.",
            "default": 100,
            "minimum": 100
        },
        "unlimited": {
            "title": "Unlimited Mode",
            "type": "boolean",
            "description": "Scrape without a results cap. Results are saved page by page as they come in, so you keep everything even if you stop the run early. Overrides Max Results. Bounded by 'Max pages per board' below.",
            "default": false
        },
        "salary_min": {
            "title": "Minimum Salary",
            "type": "integer",
            "description": "Minimum annual salary filter in the country's currency (e.g. 30000, 50000, 75000). Applied on the boards that support it and again on the parsed salaries. Leave empty for no filter.",
            "editor": "number",
            "nullable": true,
            "sectionCaption": "Filters",
            "sectionDescription": "Narrow down your job search results"
        },
        "job_type": {
            "title": "Job Type",
            "type": "string",
            "description": "Filter by employment type",
            "editor": "select",
            "default": "all",
            "enum": ["all", "permanent", "temporary", "contract", "part-time"],
            "enumTitles": ["All Types", "Permanent", "Temporary", "Contract", "Part-time"]
        },
        "posted_within_days": {
            "title": "Posted Within (days)",
            "type": "integer",
            "description": "Only keep listings posted in the last N days (e.g. 7). Listings with no readable date are kept. Leave empty for no filter.",
            "editor": "number",
            "nullable": true,
            "minimum": 1,
            "maximum": 365
        },
        "boards": {
            "title": "Job Boards to Scrape",
            "type": "array",
            "description": "Pick specific boards or leave empty to auto-select based on your chosen country. Indeed and CV-Library sit behind aggressive bot protection and are best-effort.",
            "default": [],
            "editor": "select",
            "items": {
                "type": "string",
                "enum": [
                    "reed",
                    "totaljobs",
                    "cvlibrary",
                    "cwjobs",
                    "indeed",
                    "findajob",
                    "adzuna",
                    "usajobs",
                    "indeed_us",
                    "indeed_de",
                    "indeed_fr",
                    "indeed_nl",
                    "indeed_au",
                    "remoteok",
                    "arbeitnow"
                ],
                "enumTitles": [
                    "Reed (UK)",
                    "Totaljobs (UK)",
                    "CV-Library (UK, best-effort)",
                    "CWJobs (UK)",
                    "Indeed UK (best-effort)",
                    "GOV.UK Find a Job / Work Hub",
                    "Adzuna (Multi-Country, needs free API key)",
                    "USAJobs (US Gov, needs free API key)",
                    "Indeed US (best-effort)",
                    "Indeed Germany (best-effort)",
                    "Indeed France (best-effort)",
                    "Indeed Netherlands (best-effort)",
                    "Indeed Australia (best-effort)",
                    "RemoteOK (Global Remote)",
                    "Arbeitnow (EU & Remote)"
                ]
            },
            "sectionCaption": "Board Selection",
            "sectionDescription": "Pick specific boards or leave empty to auto-select based on your chosen country"
        },
        "deduplicate": {
            "sectionCaption": "Options",
            "sectionDescription": "Control output and cost",
            "title": "Remove Duplicates",
            "type": "boolean",
            "description": "Remove the same job appearing on multiple boards (matched on title + company + town)",
            "default": true
        },
        "salary_benchmark": {
            "title": "Include Salary Benchmarks",
            "type": "boolean",
            "description": "Output salary summary statistics (median, mean, p25, p75) alongside job listings",
            "default": false
        },
        "reed_api_key": {
            "title": "Reed API Key",
            "type": "string",
            "description": "Optional: free key from https://www.reed.co.uk/developers. When set, Reed is read through its official JSON API (100 results per request, includes descriptions) instead of its web pages.",
            "editor": "textfield",
            "nullable": true,
            "isSecret": true,
            "sectionCaption": "API Keys (Optional)",
            "sectionDescription": "Free API keys unlock extra boards and make Reed cheaper and more complete"
        },
        "adzuna_app_id": {
            "title": "Adzuna App ID",
            "type": "string",
            "description": "Optional: Adzuna API App ID (free at https://developer.adzuna.com)",
            "editor": "textfield",
            "nullable": true
        },
        "adzuna_app_key": {
            "title": "Adzuna App Key",
            "type": "string",
            "description": "Optional: Adzuna API App Key",
            "editor": "textfield",
            "nullable": true,
            "isSecret": true
        },
        "usajobs_api_key": {
            "title": "USAJobs API Key",
            "type": "string",
            "description": "Required for the USAJobs board. Free at https://developer.usajobs.gov/apirequest/",
            "editor": "textfield",
            "nullable": true,
            "isSecret": true
        },
        "usajobs_user_email": {
            "title": "USAJobs Registered Email",
            "type": "string",
            "description": "The email address you registered the USAJobs API key with (sent as the User-Agent, as their API requires)",
            "editor": "textfield",
            "nullable": true
        },
        "max_pages_per_board": {
            "title": "Max pages per board",
            "type": "integer",
            "description": "Hard cap on search pages fetched per board (25-50 listings per page). Mainly bounds Unlimited Mode.",
            "default": 40,
            "minimum": 1,
            "maximum": 400,
            "sectionCaption": "Advanced",
            "sectionDescription": "Cost and reliability controls"
        },
        "proxy_mode": {
            "title": "Proxy",
            "type": "string",
            "description": "Residential proxies (default) are the most reliable for the UK job boards. Datacenter is cheaper but more often blocked. 'None' disables proxies entirely.",
            "editor": "select",
            "default": "residential",
            "enum": ["residential", "datacenter", "none"],
            "enumTitles": ["Residential (recommended)", "Datacenter (cheaper, may be blocked)", "None"]
        }
    },
    "required": ["keyword", "location"]
}
