{
    "title": "International Jobs Board Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "keyword": {
            "title": "Job Role Preset",
            "type": "string",
            "description": "Pick a common role or choose 'Custom' and type your own below",
            "editor": "select",
            "default": "software engineer",
            "enum": [
                "software engineer",
                "data analyst",
                "data scientist",
                "web developer",
                "frontend developer",
                "backend developer",
                "fullstack developer",
                "devops engineer",
                "cloud engineer",
                "cybersecurity analyst",
                "product manager",
                "project manager",
                "UX designer",
                "business analyst",
                "marketing manager",
                "accountant",
                "nurse",
                "teacher",
                "sales executive",
                "customer service",
                "warehouse operative",
                "mechanical engineer",
                "electrical engineer",
                "civil engineer",
                "HR manager",
                "__custom__"
            ],
            "enumTitles": [
                "Software Engineer",
                "Data Analyst",
                "Data Scientist",
                "Web Developer",
                "Frontend Developer",
                "Backend Developer",
                "Fullstack Developer",
                "DevOps Engineer",
                "Cloud Engineer",
                "Cybersecurity Analyst",
                "Product Manager",
                "Project Manager",
                "UX Designer",
                "Business Analyst",
                "Marketing Manager",
                "Accountant",
                "Nurse",
                "Teacher",
                "Sales Executive",
                "Customer Service",
                "Warehouse Operative",
                "Mechanical Engineer",
                "Electrical Engineer",
                "Civil Engineer",
                "HR Manager",
                "Custom (type below)"
            ]
        },
        "custom_keyword": {
            "title": "Custom Keyword",
            "type": "string",
            "description": "Type your own search keyword here. Overrides the preset above when filled in.",
            "editor": "textfield",
            "nullable": true
        },
        "location": {
            "title": "Location Preset",
            "type": "string",
            "description": "Pick a common location or choose 'Custom' and type your own below",
            "editor": "select",
            "default": "London",
            "enum": [
                "London",
                "Manchester",
                "Birmingham",
                "Leeds",
                "Edinburgh",
                "Glasgow",
                "Bristol",
                "Liverpool",
                "Cardiff",
                "Belfast",
                "Cambridge",
                "Oxford",
                "Remote",
                "New York",
                "San Francisco",
                "Los Angeles",
                "Chicago",
                "Austin",
                "Seattle",
                "Washington DC",
                "Berlin",
                "Munich",
                "Paris",
                "Amsterdam",
                "Sydney",
                "Melbourne",
                "__custom__"
            ],
            "enumTitles": [
                "London",
                "Manchester",
                "Birmingham",
                "Leeds",
                "Edinburgh",
                "Glasgow",
                "Bristol",
                "Liverpool",
                "Cardiff",
                "Belfast",
                "Cambridge",
                "Oxford",
                "Remote",
                "New York",
                "San Francisco",
                "Los Angeles",
                "Chicago",
                "Austin",
                "Seattle",
                "Washington DC",
                "Berlin",
                "Munich",
                "Paris",
                "Amsterdam",
                "Sydney",
                "Melbourne",
                "Custom (type below)"
            ]
        },
        "custom_location": {
            "title": "Custom Location",
            "type": "string",
            "description": "Type your own location here. Overrides the preset above when filled in.",
            "editor": "textfield",
            "nullable": true
        },
        "country": {
            "title": "Country / Region",
            "type": "string",
            "description": "Target country for job search. Determines which boards are auto-selected.",
            "editor": "select",
            "default": "uk",
            "enum": ["uk", "us", "de", "fr", "nl", "au", "remote"],
            "enumTitles": ["United Kingdom", "United States", "Germany", "France", "Netherlands", "Australia", "Remote / Global"]
        },
        "max_results": {
            "title": "Max Results",
            "type": "integer",
            "description": "Maximum total job listings to return (spread across all boards). Set 0 for unlimited.",
            "default": 50,
            "minimum": 0
        },
        "salary_min": {
            "title": "Minimum Salary",
            "type": "integer",
            "description": "Minimum annual salary filter (e.g. 30000, 50000, 75000). Leave empty for no filter.",
            "editor": "number",
            "nullable": true,
            "sectionCaption": "Filters",
            "sectionDescription": "Narrow down your job search results"
        },
        "job_type": {
            "title": "Job Type",
            "type": "string",
            "description": "Filter by employment type",
            "editor": "select",
            "default": "all",
            "enum": ["all", "permanent", "temporary", "contract", "part-time"],
            "enumTitles": ["All Types", "Permanent", "Temporary", "Contract", "Part-time"]
        },
        "boards": {
            "title": "Job Boards to Scrape",
            "type": "array",
            "description": "Select which boards to scrape. Leave empty to auto-select based on country. Options: reed, totaljobs, cvlibrary, cwjobs, indeed, findajob, adzuna, usajobs, remoteok, arbeitnow, indeed_us, indeed_de, indeed_fr, indeed_nl, indeed_au",
            "default": [],
            "editor": "stringList",
            "sectionCaption": "Board Selection",
            "sectionDescription": "Pick specific boards or leave empty to auto-select based on your chosen country. Board names: reed, totaljobs, cvlibrary, cwjobs, indeed, findajob, adzuna, usajobs, remoteok, arbeitnow, indeed_us, indeed_de, indeed_fr, indeed_nl, indeed_au"
        },
        "fetch_details": {
            "title": "Fetch Full Descriptions",
            "type": "boolean",
            "description": "Fetch each job's detail page for full descriptions. Costs more (extra request per job). Disable to save ~50% on compute.",
            "default": false,
            "sectionCaption": "Options",
            "sectionDescription": "Control output and cost"
        },
        "deduplicate": {
            "title": "Remove Duplicates",
            "type": "boolean",
            "description": "Remove duplicate jobs that appear on multiple boards",
            "default": true
        },
        "salary_benchmark": {
            "title": "Include Salary Benchmarks",
            "type": "boolean",
            "description": "Output salary summary statistics (median, mean, p25, p75) alongside job listings",
            "default": false
        },
        "adzuna_app_id": {
            "title": "Adzuna App ID",
            "type": "string",
            "description": "Optional: Adzuna API App ID (free at https://developer.adzuna.com)",
            "editor": "textfield",
            "nullable": true,
            "sectionCaption": "Adzuna API (Optional)",
            "sectionDescription": "Register for free API keys at https://developer.adzuna.com to enable Adzuna scraping"
        },
        "adzuna_app_key": {
            "title": "Adzuna App Key",
            "type": "string",
            "description": "Optional: Adzuna API App Key",
            "editor": "textfield",
            "nullable": true,
            "isSecret": true
        }
    },
    "required": ["keyword", "location"]
}
